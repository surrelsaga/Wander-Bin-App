# Get your API key from https://aistudio.google.com/apikey
# Used only by the serverless function (api/identify.js) — no VITE_ prefix, so it
# stays server-side and is never bundled into the browser.
GEMINI_API_KEY=your_gemini_api_key_here

VITE_ESP32_URL=/api/esp32

# To run locally with the AI scan working, use `vercel dev` (not `npm run dev`).
